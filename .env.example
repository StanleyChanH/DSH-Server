# DSH-Server 配置。复制为 .env 后修改：cp .env.example .env（或运行 make init）
# 修改后执行 `docker compose up -d` 生效；变更 DSH_VERSION / 镜像源相关项需加 --build。

# ---- 对外访问（必填） ----------------------------------------------------
# 浏览器访问的根地址（含协议，非默认端口需写明，以 / 结尾）。
# 启动日志打印的登录链接以它为准。示例：https://dsh.example.com/ 、http://203.0.113.10:8080/
DSH_PUBLIC_URL=http://203.0.113.10/
# 浏览器地址栏中的主机名或 IP，逗号分隔；不带端口时匹配任意端口。
# 不在列表中的访问地址，所有 API 请求都会被 dsh 拒绝（403）。
DSH_TRUSTED_HOSTS=203.0.113.10
# nginx server_name，"_" 表示匹配任意域名
DSH_SERVER_NAME=_

# ---- Nginx -------------------------------------------------------------
# http | https（https 需要 nginx/certs/fullchain.pem 与 nginx/certs/privkey.pem）
NGINX_MODE=http
HTTP_PORT=80
HTTPS_PORT=443
NGINX_CLIENT_MAX_BODY_SIZE=200m
NGINX_VERSION=1.28-alpine

# ---- dsh ---------------------------------------------------------------
# npm 包 @deepseek-ai/dsh 的版本：npm view @deepseek-ai/dsh dist-tags
DSH_VERSION=0.2.1-rc.5
# dsh 在容器内监听 127.0.0.1 的端口（不对外暴露）
DSH_PORT=3080
# 透传给 `dsh web` 的额外参数
DSH_EXTRA_ARGS=
# 容器内运行用户的 uid/gid，应与宿主机上 data/ 与 workspace/ 的属主一致（id -u / id -g）
DSH_UID=1000
DSH_GID=1000

# ---- 插件：灵枢 dsh-memory ------------------------------------------------
# 记忆写入凭据（md_cg fail-closed：留空 = 只读 guest，能读/召回但不落盘）。
# 由 scripts/install-plugins.sh 派生并写入 .env，无需手工填写。
MDCG_TOKEN=

# ---- 镜像源 / 时区 -----------------------------------------------------
# 默认使用国内镜像。海外服务器可全部置空/改为官方源：
#   REGISTRY_PREFIX=            （直接使用 Docker Hub）
#   NPM_REGISTRY=https://registry.npmjs.org
#   APT_MIRROR=                 （使用 deb.debian.org）
REGISTRY_PREFIX=docker.m.daocloud.io/library/
NPM_REGISTRY=https://registry.npmmirror.com
APT_MIRROR=mirrors.aliyun.com
TZ=Asia/Shanghai
