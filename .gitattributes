* text=auto eol=lf

# Shell scripts and container files must keep LF endings, even on Windows checkouts,
# otherwise the entrypoint fails with "bad interpreter".
*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.template  text eol=lf
*.yml       text eol=lf
.env*       text eol=lf
Makefile    text eol=lf

*.png binary
*.jpg binary
