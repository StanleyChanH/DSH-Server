# HTTPS mode (NGINX_MODE=https). Rendered with envsubst by the nginx image.
# Put certificates in ./nginx/certs/fullchain.pem and ./nginx/certs/privkey.pem

server {
    listen 80 default_server;
    listen [::]:80 default_server;
    server_name ${DSH_SERVER_NAME};
    return 301 https://$host:${HTTPS_PORT}$request_uri;
}

server {
    listen 443 ssl default_server;
    listen [::]:443 ssl default_server;
    http2 on;
    server_name ${DSH_SERVER_NAME};

    ssl_certificate     /etc/nginx/certs/fullchain.pem;
    ssl_certificate_key /etc/nginx/certs/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;

    client_max_body_size ${NGINX_CLIENT_MAX_BODY_SIZE};

    location / {
        proxy_pass http://127.0.0.1:${DSH_PORT};
        include /etc/nginx/snippets/dsh-proxy.conf;
        # dsh speaks plain HTTP behind the proxy, so its session cookie lacks
        # "Secure"; add it here because the browser-facing link is HTTPS.
        proxy_cookie_flags ~ secure;
    }
}
